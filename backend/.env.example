PORT=3000
MONGODB_URI=mongodb://<username>:<password>@<cluster-host>/scpr?ssl=true&replicaSet=<replica-set>&authSource=admin&appName=Cluster0
JWT_ACCESS_SECRET=your_32_character_minimum_access_secret_here_123456789
JWT_REFRESH_SECRET=your_32_character_minimum_refresh_secret_here_123456789
DB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS (optional, comma-separated list of allowed frontend origins)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# AI Service Keys (Optional / LLM backfill)
GROQ_API_KEYS=
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
GLM_API_KEYS=
OPENROUTER_API_KEYS=
AI_SERVICE_CACHE_TTL_SECONDS=3600
AI_SERVICE_DEFAULT_TIMEOUT_MS=15000
AI_SERVICE_MAX_RETRIES_PER_PROVIDER=2
